{
  "name": "sharelock-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.0.2",
  "type": "module",
  "scripts": {
    "build": "npm run generate:api && vite build",
    "check": "npm run generate:api && svelte-check --tsconfig ./tsconfig.json",
    "dev": "npm run generate:api && vite",
    "generate:api": "go run ../cmd/openapi -output ./openapi.json && openapi-typescript ./openapi.json -o ./src/shared/api/openapi.gen.ts",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@webtui/css": "0.1.10",
    "@webtui/plugin-declarative-layout": "0.0.1",
    "@webtui/theme-catppuccin": "0.0.5",
    "openapi-fetch": "^0.17.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.6"
  },
  "packageExtensions": {
    "openapi-typescript@7.13.0": {
      "peerDependencies": {
        "typescript": "^5.x || ^6.x"
      }
    }
  }
}
